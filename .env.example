# Copy to .env and adjust: `cp .env.example .env`
# docker compose reads .env automatically.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Optional. Separate secret for the client API JWTs (defaults to DJANGO_SECRET_KEY).
API_JWT_SECRET=

# Hosts Django answers to. "backend" is the service name nginx uses inside compose.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Origins allowed to POST forms to the backoffice (scheme + host + port).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 1 = create the demo users and reservations on startup (assessment only).
DJANGO_SEED_DEMO_DATA=1

DJANGO_LOG_LEVEL=INFO

# Host ports.
BACKEND_PORT=8000
CLIENT_PORT=8080
